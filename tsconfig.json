{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./lib/*"],
      "@app-types/*": ["./types/*"],
      "@components/*": ["./components/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "lib/**/*.ts", "types/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "components/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist", "server.ts", "api", "prisma", "src/main.tsx", "src/App.tsx"]
}
